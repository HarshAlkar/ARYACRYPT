# AryaCrypt Backend Environment Variables Example

# Application Settings
PROJECT_NAME="AryaCrypt Backend API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security Settings
# REQUIRED: Generate a strong secret (never commit the real value):
#   openssl rand -hex 32
# Paste the 64-character hex output below. Placeholder-looking values are rejected at startup.
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database Settings
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="aryacrypt"
POSTGRES_PORT=5432

# CORS Settings (Comma separated origins — keep explicit; do not use *)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Upload / vault limits
MAX_UPLOAD_SIZE_BYTES=104857600
VAULT_CAPACITY_BYTES=5368709120

# Rate limits (per client IP, per minute)
AUTH_RATE_LIMIT_PER_MINUTE=30
DECRYPT_RATE_LIMIT_PER_MINUTE=20

# Refresh cookie: set true in production behind HTTPS
REFRESH_COOKIE_SECURE=false

