# AryaCrypt Backend Environment Variables Example

# Application Settings
PROJECT_NAME="AryaCrypt Backend API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security Settings
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY="your-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Settings
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="root"
POSTGRES_DB="aryacrypt"
POSTGRES_PORT=5432

# CORS Settings (Comma separated origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"
