{
  "name": "aryacrypt",
  "version": "1.1.0",
  "description": "AryaCrypt: TIVRA cryptographic security framework — Aryabhata password preprocessing with PBKDF2-HMAC-SHA256 and AES-256-GCM",
  "author": "TIVRA",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "cryptography",
    "aes-gcm",
    "pbkdf2",
    "aryabhata",
    "tivra"
  ],
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
